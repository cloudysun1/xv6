# ==== Hyperliquid Credentials ====
# IMPORTANT: Use an Agent (API) Wallet, NOT your main wallet's private key.
# Generate at: https://app.hyperliquid.xyz/API
# - HL_ACCOUNT_ADDRESS : the main wallet that owns the funds (0x...)
# - HL_API_SECRET      : the AGENT wallet's private key (0x...) — sign-only, no withdraw
HL_ACCOUNT_ADDRESS=0xYourMainWalletAddress
HL_API_SECRET=0xYourAgentWalletPrivateKey

# Mainnet=https://api.hyperliquid.xyz | Testnet=https://api.hyperliquid-testnet.xyz
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_NETWORK=mainnet

# ==== Strategy Runtime ====
TREND_HL_ENV=live              # live | paper | backtest
TREND_HL_LOG_LEVEL=INFO
TREND_HL_DATA_DIR=./data

# ==== Notifications (optional) ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ==== Risk Caps ====
EQUITY_FLOOR_USD=200           # below this, kill-switch
DAILY_LOSS_LIMIT_PCT=3.0
MAX_GROSS_LEVERAGE=3.0
